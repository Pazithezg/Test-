# Environment configuration for Travel Discovery System (Bangkok)
# Copy this file to .env.local for local development

PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========================================================
# AI Provider Options:
# 1. Groq (Recommended - Free, Fast, No Project-lock):
#    Get free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_SEARCH_MODEL=openai/gpt-oss-20b

# 2. Google Gemini (required for real-time Google Search grounding):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3-flash-preview
# ========================================================

# Supabase PostgreSQL Database (Optional: if not set, system automatically uses high-fidelity local resilient store)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# System Defaults
DEFAULT_CITY=Bangkok
DEFAULT_TIMEZONE=Asia/Bangkok
DEFAULT_SEARCH_RADIUS_KM=8
